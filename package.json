{
  "name": "hermes-zalo-plugin",
  "version": "1.1.4",
  "private": true,
  "description": "Connect a personal Zalo account to the Hermes Agent gateway via zca-js (unofficial Zalo API). SSE inbound + REST outbound. Cross-platform (macOS, Linux, Windows).",
  "type": "module",
  "bin": {
    "hermes-zalo-plugin": "bin/cli.mjs"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "login": "node login.mjs",
    "setup": "node install.mjs",
    "uninstall": "node uninstall.mjs",
    "test": "node scripts/run-node-tests.mjs",
    "test:node": "node --test",
    "test:python": "python -m pytest -q",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "files": [
    "bin/",
    "bridge/",
    "scripts/",
    "systemd/",
    "hermes-plugin/*.py",
    "hermes-plugin/plugin.yaml",
    "hermes-plugin/migrations/",
    "npm-shrinkwrap.json",
    "pyproject.toml",
    "requirements-test.txt",
    "requirements-runtime.txt",
    "server.js",
    "zaloClient.js",
    "permissions.js",
    "paths.js",
    "login.mjs",
    "install.mjs",
    "uninstall.mjs",
    "README.md",
    "README.vi.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "form-data": "4.0.6"
  },
  "keywords": [
    "zalo",
    "hermes",
    "hermes-agent",
    "chatbot",
    "zca-js",
    "bridge",
    "messaging",
    "gateway"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anhakvip777/hermes-zalo-company-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/anhakvip777/hermes-zalo-company-assistant/issues"
  },
  "homepage": "https://github.com/anhakvip777/hermes-zalo-company-assistant#readme",
  "dependencies": {
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "zca-js": "2.1.2"
  }
}
