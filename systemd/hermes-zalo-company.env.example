# Copy to /etc/hermes-zalo-company.env and chmod 0600.
# Keep credentials out of config.yaml and chat logs.
ZALO_PLUGIN_HOST=127.0.0.1
ZALO_PLUGIN_PORT=8787
ZALO_PLUGIN_URL=http://127.0.0.1:8787
ZALO_PLUGIN_TOKEN=replace-with-a-random-token-at-least-32-bytes
ZALO_DATA_DIR=/var/lib/hermes-zalo
ZALO_DB_PATH=/var/lib/hermes-zalo/history/conversations.sqlite3
ZALO_MEDIA_DIR=/var/lib/hermes-zalo/history/media
ZALO_EXPORTS_DIR=/var/lib/hermes-zalo/exports
ZALO_HISTORY_RETENTION=90

# Hermes gateway environment (adjust to the installation).
HERMES_HOME=/var/lib/hermes-zalo/profile
